# Скопируйте в .env и поправьте значения:  cp .env.example .env
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=201.34.158.119
DJANGO_CSRF_TRUSTED_ORIGINS=http://201.34.158.119

# Постоянное хранилище внутри контейнера (volume app_data)
DATA_DIR=/data
SQLITE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/uploads

# Администратор создаётся при первом запуске
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password
DJANGO_SUPERUSER_EMAIL=admin@example.com
